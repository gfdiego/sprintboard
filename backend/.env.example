# Copia este archivo como .env y completa los valores.

# Cadena de conexión de Neon (Dashboard → Connect → Pooled connection)
DATABASE_URL=postgresql://usuario:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require

# Secretos para firmar los JWT (deben ser DISTINTOS). Genera cada uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_REFRESH_SECRET=cambia_esto_por_otro_secreto_largo_y_aleatorio

# Duración de los tokens: el de acceso es corto, el de refresh dura la sesión
JWT_ACCESS_EXPIRA=15m
JWT_REFRESH_EXPIRA=1d

# SameSite de la cookie del refresh token:
#   strict -> frontend y API en el mismo dominio (o localhost)
#   none   -> dominios distintos en producción (exige HTTPS)
COOKIE_SAMESITE=strict

# Cuántos proxies hay delante del servidor: 0 en local, 1 en Render/Railway/Nginx.
# Si queda en 0 detrás de un proxy, el límite de intentos bloquea a todos a la vez.
TRUST_PROXY=0

# Puerto del servidor
PORT=3000

# Origen permitido para CORS (URL del frontend)
CORS_ORIGIN=http://localhost:5173

# Rondas de bcrypt (12 en producción)
BCRYPT_ROUNDS=12

# development | production | test
NODE_ENV=development
